class Car:
    def __init__(self, year_model: int, make: str):
        """
        Constructor initializes the object attributes.
        Using double underscores (__) to enforce private data fields.
        """
        self.__year_model = int(year_model)
        self.__make = str(make)
        self.__speed = 0  # Initial velocity vector is zero at rest

    def accelerate(self):
        """Increments the car speed by 5 units."""
        self.__speed += 5

    def brake(self):
        """
        Decrements the car speed by 5 units.
        Includes a safety floor to prevent negative speed values.
        """
        if self.__speed >= 5:
            self.__speed -= 5
        else:
            self.__speed = 0

    def get_speed(self) -> int:
        """Returns the current speed value."""
        return self.__speed

def main():
    print("[INFO] Initializing Car Telemetry TestBench...")
    print("-" * 50)

my_car = Car(2026, "CyberTruck")

    print("PHASE 01: ACCELERATION SIMULATION")
    for step in range(1, 6):
        my_car.accelerate()
        print(f" -> Acceleration Cycle {step}: Current Speed = {my_car.get_speed()} km/h")

    print("-" * 50)

    print("PHASE 02: BRAKING SIMULATION")
    for step in range(1, 6):
        my_car.brake()
        print(f" -> Braking Cycle {step}     : Current Speed = {my_car.get_speed()} km/h")

    print("-" * 50)
    print("[INFO] Simulation Complete. System Status: Nominal.")


if __name__ == "__main__":
    main()
